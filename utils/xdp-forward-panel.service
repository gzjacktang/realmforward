[Unit]
Description=XDP Forward Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/xdp-panel -data /var/lib/xdp-forward-panel -bpf /usr/lib/xdp-forward-panel/xdp_forward.o -web /usr/share/xdp-forward-panel/web
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_NET_RAW
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
