#!/usr/bin/env bash
# xdp — VPS 控制台：安装 / 卸载 / 更新 / 账号 / 证书 / 服务
# 安装与更新均从 GitHub Releases 拉取预编译包（无需 Go / clang）
set -euo pipefail

DATA="${XFP_DATA:-/var/lib/xdp-forward-panel}"
LIBDIR="${XFP_LIBDIR:-/usr/lib/xdp-forward-panel}"
SHARE="${XFP_SHARE:-/usr/share/xdp-forward-panel}"
SERVICE=xdp-forward-panel.service
GITHUB_REPO="${XFP_GITHUB_REPO:-gzjacktang/xdpforward}"
RELEASE_CACHE="${XFP_RELEASE_CACHE:-/opt/xdp-forward-panel/release}"

red()  { printf '\033[31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[32m%s\033[0m\n' "$*"; }
ylw()  { printf '\033[33m%s\033[0m\n' "$*"; }
bold() { printf '\033[1m%s\033[0m\n' "$*"; }

need_root() {
  if [[ "$(id -u)" -ne 0 ]]; then
    red "请使用 root 运行: sudo xdp $*"
    exit 1
  fi
}

cfg_get() {
  local key="$1" def="${2:-}"
  [[ -f "$DATA/config.json" ]] || { echo "$def"; return; }
  python3 - "$key" "$def" <<'PY' 2>/dev/null || echo "$def"
import json,sys
k,d=sys.argv[1],sys.argv[2]
try:
  c=json.load(open("/var/lib/xdp-forward-panel/config.json"))
  v=c.get(k)
  print(v if v not in (None,"") else d)
except Exception:
  print(d)
PY
}

arch_tag() {
  case "$(uname -m)" in
    x86_64|amd64) echo linux-amd64 ;;
    aarch64|arm64) echo linux-arm64 ;;
    *)
      red "暂不支持的架构: $(uname -m)"
      exit 1
      ;;
  esac
}

# 设置全局 _XFP_TMP / _XFP_ROOT：下载并解压 Release 包
fetch_release_pkg() {
  local want_tag="${1:-}"
  local api json tag asset_url arch
  arch="$(arch_tag)"
  _XFP_TMP="$(mktemp -d)"
  apt-get install -y ca-certificates curl jq tar gzip >/dev/null 2>&1 || true

  if [[ -n "$want_tag" ]]; then
    [[ "$want_tag" == v* ]] || want_tag="v${want_tag}"
    api="https://api.github.com/repos/${GITHUB_REPO}/releases/tags/${want_tag}"
  else
    api="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"
  fi

  json="$(curl -fsSL "$api")"
  tag="$(printf '%s' "$json" | jq -r '.tag_name')"
  asset_url="$(printf '%s' "$json" | jq -r --arg a "xdpforward-${tag}-${arch}.tar.gz" \
    '.assets[] | select(.name==$a) | .browser_download_url')"
  if [[ -z "$asset_url" || "$asset_url" == "null" ]]; then
    asset_url="$(printf '%s' "$json" | jq -r --arg a "xdpforward-v${tag#v}-${arch}.tar.gz" \
      '.assets[] | select(.name==$a) | .browser_download_url')"
  fi
  if [[ -z "$asset_url" || "$asset_url" == "null" ]]; then
    red "未找到安装包: xdpforward-${tag}-${arch}.tar.gz"
    printf '%s' "$json" | jq -r '.assets[].name' >&2 || true
    rm -rf "$_XFP_TMP"
    exit 1
  fi

  bold "下载 ${asset_url} …"
  curl -fL --progress-bar "$asset_url" -o "$_XFP_TMP/pkg.tgz"
  mkdir -p "$_XFP_TMP/pkg"
  tar -xzf "$_XFP_TMP/pkg.tgz" -C "$_XFP_TMP/pkg"
  local bin
  bin="$(find "$_XFP_TMP/pkg" -maxdepth 3 -type f -path '*/bin/xdp-panel' | head -1)"
  _XFP_ROOT="$(cd "$(dirname "$bin")/.." && pwd)"
  [[ -x "$_XFP_ROOT/bin/xdp-panel" ]] || { red "解压失败"; rm -rf "$_XFP_TMP"; exit 1; }
}

cmd_status() {
  bold "=== XDP Forward Panel 状态 ==="
  if systemctl cat "$SERVICE" >/dev/null 2>&1; then
    systemctl --no-pager --full status "$SERVICE" | head -20 || true
  else
    ylw "服务未安装"
  fi
  echo
  local host port base ver
  host="$(cfg_get public_host "<IP>")"
  port="$(cfg_get listen_port 2888)"
  base="$(cfg_get base_path /)"
  [[ "$base" == "/" ]] && base=""
  ver="$(tr -d '[:space:]' </opt/xdp-forward-panel/VERSION 2>/dev/null || echo "?")"
  echo "版本: v${ver}"
  echo "面板: https://${host}:${port}${base}/"
  echo "证书: $(cfg_get tls_mode selfsigned) · SNAT: $(cfg_get snat_port_min 40000)-$(cfg_get snat_port_max 49999)"
  if [[ -x /usr/local/bin/xdp-panel ]]; then
    echo "二进制: /usr/local/bin/xdp-panel"
  fi
  if ip link show 2>/dev/null | grep -q 'prog/xdp'; then
    grn "XDP: 已挂载"
    ip link show | grep -A1 'prog/xdp' || true
  else
    ylw "XDP: 未检测到挂载（服务未运行或加载失败）"
  fi
}

cmd_start()   { need_root; systemctl start "$SERVICE"; grn "已启动"; cmd_status; }
cmd_stop()    { need_root; systemctl stop "$SERVICE"; ylw "已停止"; }
cmd_restart() { need_root; systemctl restart "$SERVICE"; grn "已重启"; sleep 1; cmd_status; }

cmd_install() {
  need_root
  if [[ -n "${XFP_INSTALL_SRC:-}" && -f "${XFP_INSTALL_SRC}/utils/install-release.sh" ]]; then
    XFP_KEEP_DATA="${XFP_KEEP_DATA:-0}" bash "${XFP_INSTALL_SRC}/utils/install-release.sh"
    return
  fi
  bold "从 GitHub Releases 安装…"
  fetch_release_pkg
  XFP_NONINTERACTIVE="${XFP_NONINTERACTIVE:-0}" \
    XFP_KEEP_DATA="${XFP_KEEP_DATA:-0}" \
    bash "$_XFP_ROOT/utils/install-release.sh"
  rm -rf "$_XFP_TMP"
  grn "CLI: xdp"
}

cmd_update() {
  need_root
  bold "从 GitHub Releases 更新…"
  fetch_release_pkg "${1:-}"
  XFP_NONINTERACTIVE=1 \
    XFP_KEEP_DATA=1 \
    XFP_TLS_MODE="$(cfg_get tls_mode selfsigned)" \
    XFP_DOMAIN="$(cfg_get public_host)" \
    XFP_EMAIL="$(cfg_get acme_email)" \
    XFP_IFACE="$(cfg_get iface)" \
    bash "$_XFP_ROOT/utils/install-release.sh"
  rm -rf "$_XFP_TMP"
  grn "更新完成"
  cmd_status
}

cmd_uninstall() {
  need_root
  echo
  ylw "将卸载面板服务、二进制与前端，并默认删除配置/数据库/证书（$DATA）。"
  read -r -p "确认卸载？输入 yes 继续: " ans
  [[ "$ans" == "yes" ]] || { echo "已取消"; return 0; }
  local wipe="yes"
  read -r -p "删除数据目录 $DATA ？[Y/n]: " wipe_ans
  wipe_ans="${wipe_ans:-Y}"
  if [[ "$wipe_ans" =~ ^[Nn] ]]; then
    wipe="no"
  fi
  systemctl stop "$SERVICE" 2>/dev/null || true
  systemctl disable "$SERVICE" 2>/dev/null || true
  systemctl stop xdp-panel-update.timer 2>/dev/null || true
  systemctl disable xdp-panel-update.timer 2>/dev/null || true
  rm -f /etc/systemd/system/xdp-forward-panel.service
  rm -f /etc/systemd/system/xdp-panel-update.service
  rm -f /etc/systemd/system/xdp-panel-update.timer
  systemctl daemon-reload
  rm -f /usr/local/bin/xdp-panel /usr/local/bin/xdp
  rm -f /usr/local/sbin/xdp-panel-issue-cert /usr/local/sbin/xdp-panel-auto-update /usr/local/sbin/xdp-panel-do-update
  rm -rf "$LIBDIR" "$SHARE"
  if [[ "$wipe" == "yes" ]]; then
    rm -rf "$DATA"
    ylw "已删除 $DATA"
  else
    echo "已保留 $DATA（下次安装会询问是否清空并重新配置）"
  fi
  rm -rf /opt/xdp-forward-panel
  grn "卸载完成"
}

cmd_passwd() {
  need_root
  [[ -f "$DATA/panel.db" ]] || { red "未找到数据库 $DATA/panel.db，请先安装"; exit 1; }
  local user newp
  user="$(python3 - <<'PY'
import sqlite3
c=sqlite3.connect("/var/lib/xdp-forward-panel/panel.db")
r=c.execute("select username from users where id=1").fetchone()
print(r[0] if r else "admin")
PY
)"
  echo "当前用户: $user"
  read -r -p "新用户名（回车保持 $user）: " nu
  [[ -z "$nu" ]] && nu="$user"
  read -r -s -p "新密码（至少 8 位）: " newp; echo
  [[ ${#newp} -ge 8 ]] || { red "密码太短"; exit 1; }
  python3 - "$nu" "$newp" <<'PY'
import sys, sqlite3, subprocess
user, plain = sys.argv[1], sys.argv[2]
try:
    import bcrypt
except ImportError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "bcrypt"])
    import bcrypt
hashed = bcrypt.hashpw(plain.encode(), bcrypt.gensalt()).decode()
db = sqlite3.connect("/var/lib/xdp-forward-panel/panel.db")
db.execute("UPDATE users SET username=?, password_hash=?, updated_at=datetime('now') WHERE id=1", (user, hashed))
db.execute("DELETE FROM sessions")
db.commit()
print("OK")
PY
  grn "账号已更新: $nu"
  echo "请使用新密码登录面板。"
}

cmd_cert() {
  need_root
  if [[ ! -x /usr/local/sbin/xdp-panel-issue-cert ]]; then
    if [[ -f "$RELEASE_CACHE/utils/issue-cert.sh" ]]; then
      install -m 0755 "$RELEASE_CACHE/utils/issue-cert.sh" /usr/local/sbin/xdp-panel-issue-cert
    else
      red "找不到 issue-cert 脚本，请先 xdp install / xdp update"
      exit 1
    fi
  fi
  if [[ "${1:-}" == "prompt" || -z "${1:-}" ]]; then
    /usr/local/sbin/xdp-panel-issue-cert prompt
  else
    /usr/local/sbin/xdp-panel-issue-cert "$@"
  fi
  systemctl restart "$SERVICE" 2>/dev/null || true
  grn "证书流程结束（已尝试重启服务）"
}

cmd_menu() {
  need_root
  while true; do
    echo
    bold "======== XDP 控制面板 ========"
    echo "  1) 状态"
    echo "  2) 启动"
    echo "  3) 停止"
    echo "  4) 重启"
    echo "  5) 更新"
    echo "  6) 更改用户名/密码"
    echo "  7) 安装/更换证书"
    echo "  8) 卸载"
    echo "  0) 退出"
    echo "=============================="
    read -r -p "请选择: " c
    case "$c" in
      1) cmd_status ;;
      2) cmd_start ;;
      3) cmd_stop ;;
      4) cmd_restart ;;
      5) cmd_update ;;
      6) cmd_passwd ;;
      7) cmd_cert prompt ;;
      8) cmd_uninstall ;;
      0|q|Q) exit 0 ;;
      *) ylw "无效选项" ;;
    esac
  done
}

usage() {
  cat <<EOF
xdp — XDP Forward Panel 管理工具

用法:
  xdp                 打开交互控制菜单
  xdp status          查看状态
  xdp start|stop|restart
  xdp install         从 GitHub Releases 安装
  xdp update [vX.Y.Z] 拉取最新（或指定 tag）预编译包并更新
  xdp uninstall       卸载
  xdp passwd          更改用户名/密码
  xdp cert [prompt|selfsigned|letsencrypt|zerossl ...]
  xdp help

一键安装（新机器，无需 Go/clang）:
  bash <(curl -fsSL https://raw.githubusercontent.com/gzjacktang/xdpforward/main/utils/install-remote.sh)
EOF
}

main() {
  local cmd="${1:-menu}"
  shift || true
  case "$cmd" in
    menu|"")   cmd_menu ;;
    status)    cmd_status ;;
    start)     cmd_start ;;
    stop)      cmd_stop ;;
    restart)   cmd_restart ;;
    install)   cmd_install "$@" ;;
    update)    cmd_update "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    passwd|account|password) cmd_passwd "$@" ;;
    cert|tls)  cmd_cert "$@" ;;
    help|-h|--help) usage ;;
    *) red "未知命令: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
